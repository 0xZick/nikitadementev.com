---
import Base from '../layouts/Base.astro';
import { person } from '../data/person';
---

<Base title={`404 — ${person.name}`} pageId="404">
  <h1 class="page-title">_404</h1>
  <div class="article prose">
    <p class="hero-kicker">not found</p>
    <p class="hero-name" style="font-size: clamp(2.4rem, 5vw, 3.6rem); line-height: 1.1">Nothing at this path.</p>
    <p class="meta">The site is small. Everything is one click from here.</p>
    <ul>
      <li><a href="/">/ — front page</a></li>
      <li><a href="/bio">/bio — full biography</a></li>
      <li><a href="/work">/work — products, stack, GitHub</a></li>
      <li><a href="/writing">/writing — notes</a></li>
      <li><a href="/llms.txt">/llms.txt — machine digest</a></li>
    </ul>
  </div>
</Base>
