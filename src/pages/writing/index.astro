---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { person } from '../../data/person';

const notes = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const minutes = (body?: string) => Math.max(1, Math.round((body ?? '').split(/\s+/).length / 180));
---

<Base title={`_writing — ${person.name}`} description="Notes: experiments, numbers, what did not work." pageId="writing">
  <h1 class="page-title">_writing</h1>
  <div class="article prose">
    <p class="meta">notes with the losses left in · <a href="/rss.xml">rss</a></p>
    {notes.length === 0 && <p>Nothing published yet.</p>}
    <ul class="note-list">
      {
        notes.map((n) => (
          <li class="paper">
            <span class="paper-date">
              {fmt(n.data.date)}
              <br />
              <span class="paper-min">{minutes(n.body)} min</span>
            </span>
            <a href={`/writing/${n.id}/`} lang={n.data.lang}>
              {n.data.title}
            </a>
            <p class="paper-summary" lang={n.data.lang}>
              {n.data.summary}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
